<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:elevation="6dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- 1. الشريط العلوي: زر الإغلاق وأيقونات وسائل النقل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- زر الإغلاق (X) -->
        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_clear"
            app:tint="#3C4043" />

        <!-- شريط وسائل النقل الأفقي -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- سيارة 🚗 -->
                <ImageView
                    android:id="@+id/vehicle"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_mode_selected"
                    android:padding="8dp"
                    android:src="@drawable/ic_car"
                    app:tint="#1A73E8" />

                <!-- قطار / نقل عام 🚆 -->
                <ImageView
                    android:id="@+id/transit"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_train"
                    app:tint="#5F6368" />

                <!-- مشي 🚶 -->
                <ImageView
                    android:id="@+id/pedestrian"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_walk"
                    app:tint="#5F6368" />

                <!-- عجلة / مكنة 🚴 -->
                <ImageView
                    android:id="@+id/bicycle"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_bike"
                    app:tint="#5F6368" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 2. قسم خانات البداية والوجهة مع زر التبديل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- زر التبديل السريع (⇅ Swap) -->
        <ImageView
            android:id="@+id/btn_swap"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_swap_vertical"
            app:tint="#5F6368" />

        <!-- صندوقا البحث المزدوجان -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- خانة نقطة البداية (مع زر GPS السريع) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F1F3F4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="#5F6368" />

                    <TextView
                        android:id="@+id/tv_start_point"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="موقعك"
                        android:textColor="#1A73E8"
                        android:textSize="13sp" />

                    <!-- زرار الـ GPS التفاعلي لاختيار موقعك فوراً -->
                    <ImageView
                        android:id="@+id/btn_my_location_quick"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:src="@drawable/ic_my_location"
                        app:tint="#1A73E8" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- خانة نقطة الوجهة (Destination) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F1F3F4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_marker"
                        app:tint="#EA4335" />

                    <TextView
                        android:id="@+id/tv_end_point"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:hint="اختر الوجهة..."
                        android:textColor="#202124"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. زر الاختصار السريع لموقعك أسفل الخانات -->
    <LinearLayout
        android:id="@+id/btn_my_location_bar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="?selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:src="@drawable/ic_my_location"
            app:tint="#00796B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="موقعك الحالي"
            android:textColor="#202124"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>