<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/routing_types_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:elevation="6dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- 1. الشريط العلوي: زر الرجوع ومجموعة وسائل النقل (Google Maps Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#3C4043" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <!-- استخدام RadioGroup بالاسم الأصلي ليتعرف عليه كود التطبيق تلقائياً -->
            <RadioGroup
                android:id="@+id/route_type"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/vehicle"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@android:color/darker_gray"
                    android:drawableTop="@drawable/ic_car"
                    app:drawableTint="#1A73E8" />

                <RadioButton
                    android:id="@+id/transit"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:drawableTop="@android:drawable/ic_menu_directions"
                    app:drawableTint="#5F6368" />

                <RadioButton
                    android:id="@+id/pedestrian"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:drawableTop="@android:drawable/ic_menu_directions"
                    app:drawableTint="#5F6368" />

                <RadioButton
                    android:id="@+id/bicycle"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:button="@null"
                    android:gravity="center"
                    android:drawableTop="@drawable/ic_bike"
                    app:drawableTint="#5F6368" />
            </RadioGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 2. قسم خانات البداية والوجهة (ستايل جوجل مابس المزدوج) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_swap"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#5F6368" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- خانة نقطة البداية -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F1F3F4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="#5F6368" />

                    <TextView
                        android:id="@+id/tv_start_point"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="موقعك"
                        android:textColor="#1A73E8"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- خانة نقطة الوجهة -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F1F3F4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_dialog_map"
                        app:tint="#EA4335" />

                    <TextView
                        android:id="@+id/tv_end_point"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:hint="اختر الوجهة..."
                        android:textColor="#202124"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>